# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env — он в .gitignore.

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- GLM (Z.ai) ---
# ВАЖНО: по решению владельца проекта здесь используется ключ от GLM Coding Plan
# (подписка Lite/Pro/Max), а не pay-as-you-go ключ.
# Внимание: у большинства провайдеров Coding Plan-ключи по условиям использования
# предназначены для работы внутри coding-инструментов (IDE/CLI-агенты), а не для
# встраивания в отдельный продукт с собственными API-вызовами (см. AGENTS.md).
# Используется в будущих итерациях (vision-analysis, text-aggregation) — в этой
# итерации реальных вызовов GLM ещё нет.
GLM_API_KEY=
GLM_API_BASE_URL=

# --- Геокодинг ---
# Используется в будущей итерации (geocoding). Пока не требуется.
GEOCODING_API_KEY=

# --- База данных ---
# Для MVP — путь к SQLite файлу, например: sqlite:///storage/locations.db
DATABASE_URL=sqlite:///storage/locations.db

# --- Локальное хранилище (эта итерация) ---
# Куда сохранять пересланные видео до обработки
MEDIA_STORAGE_DIR=media/videos
